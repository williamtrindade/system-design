      "updated": 1789599933436,
      "link": null,
      "locked": false,
      "text": "Functional Requiriments\n-> Customenr can buy an ticket\n-> Customer can see events\n\n-> Manager can create events",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requiriments\n-> Customenr can buy an ticket\n-> Customer can see events\n\n-> Manager can create events",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UGcPng8qusMsUqh3E1PlH",
      "type": "text",
      "x": 257.79998779296875,
      "y": 350.96246337890625,
      "width": 250.1597137451172,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 418935755,
      "version": 247,
      "versionNonce": 529834213,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789600656877,
      "link": null,
      "locked": false,
      "text": "N-Functional Requiriments\nEtimation\n-> 1m read access\n-> 1k write access\n-> 1:100 w/r\n\n-> Data consistency\n-> Low Latency\n-> High Avaliability\n\n-> High Pick Times\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "N-Functional Requiriments\nEtimation\n-> 1m read access\n-> 1k write access\n-> 1:100 w/r\n\n-> Data consistency\n-> Low Latency\n-> High Avaliability\n\n-> High Pick Times\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
