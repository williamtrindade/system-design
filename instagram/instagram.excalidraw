    {
      "id": "pLWKmv7nYPxYFRHqC4G1t",
      "type": "text",
      "x": 4302.658507053305,
      "y": 189.08279234263503,
      "width": 781.3594970703125,
      "height": 1650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06",
